# Line endings are a property of this repository, not of whoever cloned it.
# Without this file the behaviour depends on each machine's core.autocrlf,
# which means CI and a Windows checkout can disagree about what a file is.

# Normalise everything to LF in the repository. Windows working copies may
# still get CRLF; that is Git's business and does not reach a commit.
* text=auto eol=lf

# Files that must be LF even in the working copy. Shell scripts with CRLF
# fail on Linux with the notoriously unhelpful "bad interpreter: no such
# file or directory", and Phase 1 onwards will have some.
*.sh   text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf

# Binary, never touched.
*.png  binary
*.tar.gz binary